# ==============================================================================
# ORCA — Open-Source Marine and Coastal Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL Database (Shared source of truth)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://orca_user:orca_password@localhost:5432/orca_db

# LLM Providers (Priority: 1. Groq, 2. Gemini, 3. OpenRouter)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Models
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-pro
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# External Data API Configurations (Optional / Public defaults)
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
IBTRACS_DATA_PATH=data/raw/ibtracs
WORLDPOP_DATA_PATH=data/raw/worldpop

# Frontend Public Env (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
