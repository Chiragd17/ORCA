{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": "./frontend",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["frontend/src/**/*"],
  "exclude": ["node_modules", "**/node_modules/*", "backend"]
}
